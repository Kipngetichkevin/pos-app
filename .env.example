APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Africa/Nairobi

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --- POS offline / cloud sync ---
# standalone = one server, no syncing | branch = shop server that syncs to the cloud | cloud = central server
POS_MODE=standalone
# Branch servers only (get these from `php artisan pos:branch-token CODE` on the cloud):
POS_CLOUD_URL=
POS_BRANCH_ID=
POS_SYNC_TOKEN=

# --- KRA eTIMS ---
# off | fake (training only, NOT sent to KRA) | oscu (direct to KRA, needs certification) | integrator
ETIMS_DRIVER=off
ETIMS_PIN=
ETIMS_BRANCH_ID=00
# oscu: sandbox https://etims-api-sbx.kra.go.ke/etims-api, live https://etims-api.kra.go.ke/etims-api
ETIMS_OSCU_URL=https://etims-api-sbx.kra.go.ke/etims-api
ETIMS_DEVICE_SERIAL=
ETIMS_CMC_KEY=
# integrator: the provider's API address and key
ETIMS_INTEGRATOR_URL=
ETIMS_INTEGRATOR_KEY=

# --- Backups (pos:backup runs nightly at 22:30) ---
POS_BACKUP_PATH=
MYSQLDUMP_PATH=mysqldump
